<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>QNAgent</AssemblyName>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <ApplicationManifest>../app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets/qn-agent.ico</ApplicationIcon>
    <RestorePackagesPath>$(MSBuildThisFileDirectory)../.tools/nuget</RestorePackagesPath>
  </PropertyGroup>
  <PropertyGroup Condition="'$(PortableRelease)' == 'true'">
    <DefineConstants>$(DefineConstants);PORTABLE_RELEASE</DefineConstants>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>
  <ItemGroup Condition="'$(PortableRelease)' == 'true'">
    <Compile Remove="*Checks.cs" />
  </ItemGroup>
  <ItemGroup><ProjectReference Include="../qnocr-poc.csproj" /></ItemGroup>
  <ItemGroup><Resource Include="Assets/qn-agent.ico" /></ItemGroup>
  <Target Name="CopyNativeWorkerHost" AfterTargets="Build" Condition="'$(PortableRelease)' != 'true'">
    <ItemGroup>
      <WorkerFiles Include="../bin/$(Configuration)/net8.0-windows/win-x64/qnocr-poc.exe;../bin/$(Configuration)/net8.0-windows/win-x64/qnocr-poc.runtimeconfig.json;../bin/$(Configuration)/net8.0-windows/win-x64/qnocr-poc.deps.json" />
    </ItemGroup>
    <Copy SourceFiles="@(WorkerFiles)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>
</Project>
