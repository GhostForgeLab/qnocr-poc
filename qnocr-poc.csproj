<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <RestorePackagesPath>$(MSBuildThisFileDirectory).tools/nuget</RestorePackagesPath>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <PropertyGroup Condition="'$(PortableRelease)' == 'true'">
    <DefineConstants>$(DefineConstants);PORTABLE_RELEASE</DefineConstants>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>
  <ItemGroup>
    <Using Include="System.IO" />
    <Compile Remove="Validation/**/*.cs" />
    <Compile Remove="Output/**/*.cs" />
    <Compile Remove="KnowledgeConsole/**/*.cs" />
    <Compile Remove="AgentConsole/**/*.cs" />
    <Compile Remove="DesktopClient/**/*.cs" />
    <Compile Remove="Integration/**/*.cs" />
    <Compile Remove="RuntimeObserver/Program.cs" />
    <Compile Remove="RuntimeObserver/obj/**/*.cs" />
    <None Update="Product/product-profiles.sample.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Condition="'$(PortableRelease)' != 'true'" />
    <PackageReference Include="Sdcb.PaddleOCR" Version="3.3.1" />
    <PackageReference Include="Sdcb.PaddleOCR.Models.Local" Version="3.3.1" />
    <PackageReference Include="Sdcb.PaddleInference.runtime.win64.mkl" Version="3.3.1.70" />
    <PackageReference Include="OpenCvSharp4" Version="4.11.0.20250507" />
    <PackageReference Include="OpenCvSharp4.runtime.win" Version="4.11.0.20250507" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.28" />
  </ItemGroup>
</Project>
