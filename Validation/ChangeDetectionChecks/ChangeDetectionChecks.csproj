<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>true</UseWPF>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RestorePackagesPath>$(MSBuildThisFileDirectory)../../.tools/nuget</RestorePackagesPath>
  </PropertyGroup>
  <ItemGroup>
    <Using Include="System.IO" />
    <ProjectReference Include="../../qnocr-poc.csproj" />
    <Compile Include="../AgentSessionPersistenceChecks.cs" Link="AgentSessionPersistenceChecks.cs" />
    <Compile Include="../RealMessageContextChecks.cs" Link="RealMessageContextChecks.cs" />
    <Compile Include="../IdentityNormalizationChecks.cs" Link="IdentityNormalizationChecks.cs" />
    <Compile Include="../RealMultiBuyerContextChecks.cs" Link="RealMultiBuyerContextChecks.cs" />
    <Compile Include="../AgentContextIntentChecks.cs" Link="AgentContextIntentChecks.cs" />
    <Compile Include="../AgentContextKnowledgeChecks.cs" Link="AgentContextKnowledgeChecks.cs" />
  </ItemGroup>
</Project>
